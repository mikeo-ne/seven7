{
  "name": "seven7-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "seven7 DAW user interface (React + TypeScript). Hosted by JUCE WebBrowserComponent in the desktop app, or by Vite + s7bridge during development.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:engine": "S7_BRIDGE=http://127.0.0.1:8787 vitest run"
  },
  "dependencies": {
    "@juce-framework/webview": "^1.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "happy-dom": "^17.6.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.7"
  }
}